{
  "name": "timermask-android",
  "version": "3.0.0",
  "private": true,
  "description": "Capacitor wrapper that turns the TimerMask web app into the Google Play Android app.",
  "scripts": {
    "prepare-www": "node prepare-www.mjs",
    "add-android": "npx cap add android",
    "sync": "node prepare-www.mjs && npx cap sync android",
    "open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor-community/admob": "latest",
    "@capacitor-community/keep-awake": "latest",
    "cordova-plugin-purchase": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}